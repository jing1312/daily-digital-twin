{
  "name": "daily-digital-twin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test",
    "audit:privacy": "node --disable-warning=ExperimentalWarning scripts/privacy-audit.mjs",
    "smoke": "bash .github/scripts/cli-smoke.sh",
    "lint:ps": "pwsh -NoProfile -File scripts/lint-powershell.ps1",
    "selftest:ps": "pwsh -NoProfile -File platform/windows/Test-DailyTwinPlatform.ps1",
    "runtime": "node --disable-warning=ExperimentalWarning src/runtime.mjs",
    "doctor": "node --disable-warning=ExperimentalWarning src/runtime.mjs doctor",
    "config": "node --disable-warning=ExperimentalWarning scripts/config-ui.mjs",
    "check": "npm test && npm run audit:privacy && npm run smoke"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.78",
    "zod": "4.4.3"
  }
}
